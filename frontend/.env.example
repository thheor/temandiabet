# Single server: `php -S localhost:5173 router.php` serving the built app and the
# API. Same origin, so the API base is a relative path and CORS never applies.
VITE_BASE_PATH=/temandiabet/
VITE_API_BASE_URL=http://localhost:8000/temandiabet/backend

# Two servers: Vite dev on :5173 (`npm run dev`) with the API on :8000
# (`php -S localhost:8000 router.php`). Cross-origin, so port 5173 must stay in
# the backend CORS allowlist.
# VITE_BASE_PATH=/temandiabet/
# VITE_API_BASE_URL=http://localhost:8000/temandiabet/backend

# XAMPP: repo at htdocs/temandiabet
# VITE_BASE_PATH=/temandiabet/
# VITE_API_BASE_URL=http://localhost/temandiabet/backend

# Production: served at the domain root, no prefix
# VITE_BASE_PATH=/
# VITE_API_BASE_URL=/backend
